+  @override
+  void initState() {
+    super.initState();
+    SharedPreferences.getInstance().then((prefs) {
+      if (!mounted) return;
+      setState(() {
+        _enabled = prefs.getBool(voiceAnnouncementsPrefKey) ?? true;
+      });
+    });
+  }
