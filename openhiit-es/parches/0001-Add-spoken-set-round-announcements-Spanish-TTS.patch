diff --git a/lib/features/run_timer/voice/voice_announcements.dart b/lib/features/run_timer/voice/voice_announcements.dart
new file mode 100644
index 0000000..f35c7f6
--- /dev/null
+++ b/lib/features/run_timer/voice/voice_announcements.dart
@@ -0,0 +1,68 @@
+import 'package:background_hiit_timer/models/interval_type.dart';
+
+/// Interval names that are not work intervals. Same list used by
+/// generateIntervalDisplaysForTimer to decide what counts as "active".
+const List<String> nonWorkIntervalNames = [
+  "Rest",
+  "Get Ready",
+  "Warmup",
+  "Cooldown",
+  "Break",
+];
+
+/// Builds the Spanish text spoken at the start of each interval.
+///
+/// Terminology:
+/// - "serie": one full pass of the block (timer restarts + 1).
+/// - "tanda": one work interval inside a serie (timer activeIntervals).
+///
+/// Returns a map from interval index (position in [intervals]) to the text
+/// to speak. Intervals without an entry are not announced.
+Map<int, String> buildVoiceAnnouncements({
+  required List<IntervalType> intervals,
+  required int activeIntervalsPerSet,
+  required int totalSets,
+}) {
+  final Map<int, String> announcements = {};
+  if (activeIntervalsPerSet <= 0) return announcements;
+
+  int workCount = 0;
+  for (int i = 0; i < intervals.length; i++) {
+    final String name = intervals[i].name;
+
+    if (!nonWorkIntervalNames.contains(name)) {
+      final int serie = workCount ~/ activeIntervalsPerSet + 1;
+      final int tanda = workCount % activeIntervalsPerSet + 1;
+      workCount++;
+      announcements[i] = workAnnouncement(
+        serie: serie,
+        totalSets: totalSets,
+        tanda: tanda,
+        totalTandas: activeIntervalsPerSet,
+      );
+    } else if (name == "Break" && workCount > 0) {
+      final int nextSerie = workCount ~/ activeIntervalsPerSet + 1;
+      if (nextSerie <= totalSets) {
+        announcements[i] =
+            "Descanso. Siguiente: serie $nextSerie de $totalSets.";
+      }
+    }
+  }
+
+  return announcements;
+}
+
+String workAnnouncement({
+  required int serie,
+  required int totalSets,
+  required int tanda,
+  required int totalTandas,
+}) {
+  final String seriePart = "Serie $serie de $totalSets.";
+  final String tandaPart = "Tanda $tanda de $totalTandas.";
+
+  if (totalSets <= 1 && totalTandas <= 1) return "Adelante.";
+  if (totalSets <= 1) return tandaPart;
+  if (totalTandas <= 1) return seriePart;
+  return "$seriePart $tandaPart";
+}
diff --git a/lib/features/run_timer/voice/voice_announcer.dart b/lib/features/run_timer/voice/voice_announcer.dart
new file mode 100644
index 0000000..725e9e9
--- /dev/null
+++ b/lib/features/run_timer/voice/voice_announcer.dart
@@ -0,0 +1,90 @@
+import 'package:flutter/foundation.dart';
+import 'package:flutter_tts/flutter_tts.dart';
+import 'package:openhiit/core/logs/logs.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+/// SharedPreferences key for the global on/off switch.
+const String voiceAnnouncementsPrefKey = 'voiceAnnouncements';
+
+/// Speaks set/round announcements with the device text-to-speech engine.
+class VoiceAnnouncer {
+  /// Wait before speaking so the voice does not overlap the interval's
+  /// start sound.
+  static const Duration startDelay = Duration(milliseconds: 600);
+
+  final FlutterTts _tts = FlutterTts();
+  SharedPreferences? _prefs;
+  bool _enabled = true;
+  bool _ready = false;
+  int _lastIndex = -1;
+
+  Future<void> init() async {
+    final prefs = await SharedPreferences.getInstance();
+    _enabled = prefs.getBool(voiceAnnouncementsPrefKey) ?? true;
+    if (!_enabled) {
+      _prefs = prefs;
+      return;
+    }
+
+    try {
+      await _tts.setLanguage('es-ES');
+      await _tts.setSpeechRate(0.5);
+      await _tts.setPitch(1.0);
+      await _tts.awaitSpeakCompletion(false);
+      if (!kIsWeb && defaultTargetPlatform == TargetPlatform.iOS) {
+        // Play over the silent switch and lower other audio while speaking.
+        await _tts.setIosAudioCategory(
+          IosTextToSpeechAudioCategory.playback,
+          [
+            IosTextToSpeechAudioCategoryOptions.mixWithOthers,
+            IosTextToSpeechAudioCategoryOptions.duckOthers,
+          ],
+          IosTextToSpeechAudioMode.defaultMode,
+        );
+      }
+      _ready = true;
+    } catch (e) {
+      Log.error("voice announcer init failed", e);
+    }
+    // Set last: marks init as finished for onInterval().
+    _prefs = prefs;
+  }
+
+  /// Call on every timer update. Speaks only when [intervalIndex] changes
+  /// and there is an announcement for it.
+  void onInterval({
+    required int intervalIndex,
+    required Map<int, String> announcements,
+    required bool paused,
+  }) {
+    // Preferences not loaded yet: do not consume the interval, so it can
+    // still be announced on a later update once init() finishes.
+    if (_prefs == null) return;
+    if (intervalIndex == _lastIndex) return;
+    _lastIndex = intervalIndex;
+
+    if (!_enabled || !_ready || paused) return;
+    final String? text = announcements[intervalIndex];
+    if (text == null) return;
+
+    Future.delayed(startDelay, () async {
+      // Skip if the interval changed again during the delay.
+      if (_lastIndex != intervalIndex) return;
+      try {
+        // Same volume the timer sounds use (0-100, set by the volume slider).
+        final double volume = _prefs?.getDouble('volume') ?? 80;
+        await _tts.setVolume((volume / 100).clamp(0.0, 1.0));
+        await _tts.speak(text);
+      } catch (e) {
+        Log.error("voice announcement failed", e);
+      }
+    });
+  }
+
+  Future<void> dispose() async {
+    _lastIndex = -2;
+    try {
+      await _tts.stop();
+    } catch (_) {}
+  }
+}
