From 0fc03721724edf0d7f17494c1ebbb3dce0e5643c Mon Sep 17 00:00:00 2001
From: aker1305 <aker1305@gmail.com>
Date: Sat, 7 Nov 2026 18:03:56 +0000
Subject: [PATCH 3/5] Android: own application ID and label for the Spanish
 build

applicationId com.aker1305.openhiit_es and label "OpenHIIT ES" so it
installs next to the official OpenHIIT without a signature conflict.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01X5W6dQ9ZgyihWUfbUDrb4L
---
 android/app/build.gradle                 | 3 ++-
 android/app/src/main/AndroidManifest.xml | 2 +-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/android/app/build.gradle b/android/app/build.gradle
index 708e066..d45d752 100644
--- a/android/app/build.gradle
+++ b/android/app/build.gradle
@@ -49,7 +49,8 @@ android {
 
     defaultConfig {
         // TODO: Specify your own unique Application ID (https://developer.android.com/studio/build/application-id.html).
-        applicationId "com.codepup.workout_timer"
+        // Own ID so this Spanish build installs next to the official OpenHIIT.
+        applicationId "com.aker1305.openhiit_es"
         // You can update the following values to match your application needs.
         // For more information, see: https://docs.flutter.dev/deployment/android#reviewing-the-gradle-build-configuration.
         minSdkVersion flutter.minSdkVersion
diff --git a/android/app/src/main/AndroidManifest.xml b/android/app/src/main/AndroidManifest.xml
index e100931..be225f4 100644
--- a/android/app/src/main/AndroidManifest.xml
+++ b/android/app/src/main/AndroidManifest.xml
@@ -14,7 +14,7 @@
         </intent>
     </queries>
    <application
-        android:label="OpenHIIT"
+        android:label="OpenHIIT ES"
         android:requestLegacyExternalStorage="true"
         android:name="${applicationName}"
         android:icon="@mipmap/launcher_icon">
